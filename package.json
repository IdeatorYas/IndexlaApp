{
  "name": "indexla-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3456",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "compile:contracts": "hardhat compile",
    "test:contracts": "hardhat test",
    "node:local": "hardhat node --port 8545",
