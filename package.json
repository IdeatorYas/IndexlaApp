    "test:e2e:stable-club": "playwright test --config playwright.stable-club.config.ts",
    "postinstall": "node scripts/ensure-wagmi2-connectors.cjs"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@tanstack/react-query": "^5.102.8",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/extensions": "^2.25.0",
    "@x402/svm": "^2.25.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.2",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "hardhat": "^2.26.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@wagmi/core": "2.22.1",
    "@wagmi/connectors": "6.2.0",
    "@reown/appkit-adapter-wagmi": {
      "@wagmi/connectors": "6.2.0",
