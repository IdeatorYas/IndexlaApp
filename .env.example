# INDEXLA App — environment template (no secrets committed)

# development | staging | production
INDEXLA_ENV=development

# Set true only on staging to preview utility UI (still labeled non-production)
INDEXLA_DEMO_UTILITIES=false

# Production utility activation (leave false until real $DEXLA launch)
DEXLA_UTILITY_ENABLED=false
FEATURED_PLACEMENTS_ENABLED=false
PRIVATE_STRATEGY_PAYMENTS_ENABLED=false
CREATOR_PUBLISH_BURN_ENABLED=false
EARLY_CREATOR_PUBLISH_EXEMPTION_ENABLED=false
CROSS_CHAIN_ENABLED=false
COW_EXECUTION_ENABLED=false
INVESTOR_REWARD_CLAIMS_ENABLED=false

# Per-network execution (disabled until integrated)
NETWORK_ETHEREUM_ENABLED=false
NETWORK_BASE_ENABLED=false
NETWORK_ARBITRUM_ENABLED=false
NETWORK_BNB_ENABLED=false
NETWORK_SOLANA_ENABLED=false
NETWORK_SUI_ENABLED=false
NETWORK_ROBINHOOD_ENABLED=false

NEXT_PUBLIC_INDEXLA_ENV=production
NEXT_PUBLIC_APP_URL=https://app.indexla.tech
PORT=3001
