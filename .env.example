# INDEXLA App — environment template (no secrets committed)

# development | staging | production
INDEXLA_ENV=development

# Preview illustrative marketplace data (default true until testnet cutover)
ILLUSTRATIVE_DEMO_DATA=true
NEXT_PUBLIC_ILLUSTRATIVE_DEMO_DATA=true

# Set true only on staging to preview utility UI (still labeled non-production)
INDEXLA_DEMO_UTILITIES=false

# Production utility activation (leave false until real $DEXLA launch)
DEXLA_UTILITY_ENABLED=false
FEATURED_PLACEMENTS_ENABLED=false
PRIVATE_STRATEGY_PAYMENTS_ENABLED=false
CREATOR_PUBLISH_BURN_ENABLED=false
EARLY_CREATOR_PUBLISH_EXEMPTION_ENABLED=false
CROSS_CHAIN_ENABLED=false
COW_EXECUTION_ENABLED=false
INVESTOR_REWARD_CLAIMS_ENABLED=false

# Per-network execution (disabled until integrated)
NETWORK_ETHEREUM_ENABLED=false
NETWORK_BASE_ENABLED=false
NETWORK_ARBITRUM_ENABLED=false
NETWORK_BNB_ENABLED=false
NETWORK_SOLANA_ENABLED=false
NETWORK_SUI_ENABLED=false
NETWORK_ROBINHOOD_ENABLED=false

# Future: live | testnet (only used when ILLUSTRATIVE_DEMO_DATA=false)
# INDEXLA_DATA_SOURCE=live

# CoinGecko Demo API (server-only — never expose to client)
COINGECKO_API_KEY=
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3

# Twelve Data (server-only — stocks/ETFs; never expose to client / never use NEXT_PUBLIC_)
TWELVE_DATA_API_KEY=
TWELVE_DATA_API_BASE_URL=https://api.twelvedata.com

# QuickNode + LI.FI (Stable Club — server-only; never expose to client)
QUICKNODE_RPC_URL=
LIFI_API_KEY=
BASE_RPC_URL=
# Optional second upstream for /api/stable-club/base-rpc when BASE_RPC_URL rate-limits
# BASE_RPC_FALLBACK_URL=
ETHEREUM_RPC_URL=
# Optional browser HTTPS fallback only (never put API keys in NEXT_PUBLIC_*):
# NEXT_PUBLIC_BASE_RPC_FALLBACK_URL=

# Stable Club Base mainnet deploy (broadcast only via deploy-base-mainnet.cjs --network base)
# BASE_RPC_URL must be HTTPS public Base RPC (no localhost / private IP / Hardhat / Anvil)
# DEPLOYER_PRIVATE_KEY=
# STABLE_CLUB_GUARDIAN_ADDRESS=
# Exact phrase required (see scripts/stable-club/base-mainnet-deploy-guards.cjs):
# STABLE_CLUB_BASE_DEPLOY_CONFIRMATION=
# STABLE_CLUB_DEPLOY_RELEASE_COMMIT=

# Stable Club Step 1 (local development — route hidden unless enabled)
STABLE_CLUB_DEV_ENABLED=false
NEXT_PUBLIC_STABLE_CLUB_DEV_ENABLED=false
STABLE_CLUB_FEE_RECIPIENT=

NEXT_PUBLIC_INDEXLA_ENV=production
NEXT_PUBLIC_APP_URL=https://app.indexla.tech
PORT=3001
